export struct TabData {
    title: string,
    active: bool,
    favicon: image,
    is-loading: bool,
}

export component TabBar inherits Rectangle {
    in property <[TabData]> tabs;
    callback close_tab(int);
    callback switch_tab(int);
    callback new_tab();

    height: 35px;
    background: #e0e6ed;

    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        spacing: 5px;
        alignment: start;

        // Tabs List
        for tab[i] in root.tabs : Rectangle {
            width: 150px;
            height: 30px;
            y: 5px; // Align to bottom
            background: tab.active ? #ffffff : #d1d9e6;
            border-top-left-radius: 8px;
            border-top-right-radius: 8px;
            
            TouchArea {
                clicked => { root.switch_tab(i); }
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 5px;
                spacing: 5px;
                
                Image {
                    source: tab.favicon;
                    width: 16px;
                    height: 16px;
                    y: 7px;
                    visible: !tab.is-loading;
                }

                Text {
                    text: tab.is-loading ? "↻" : "";
                    color: #555555;
                    font-size: 14px;
                    vertical-alignment: center;
                    visible: tab.is-loading;
                }

                Text {
                    text: tab.title;
                    vertical-alignment: center;
                    color: tab.active ? #333333 : #666666;
                    overflow: elide;
                    width: 100%;
                }
                
                Rectangle {
                    width: 20px;
                    height: 20px;
                    y: 5px;
                    border-radius: 10px;
                    background: transparent; // Hover effect later
                    
                    Text {
                        text: "x";
                        color: #888888;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    
                    TouchArea {
                        clicked => { root.close_tab(i); }
                    }
                }
            }
        }

        // Add Tab Button
        Rectangle {
            width: 30px;
            height: 30px;
            y: 5px;
            background: transparent;
            
            Text {
                text: "+";
                font-size: 20px;
                vertical-alignment: center;
                horizontal-alignment: center;
                color: #555555;
            }
            
            TouchArea {
                clicked => { root.new_tab(); }
            }
        }
    }
}
