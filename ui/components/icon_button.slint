import { VerticalBox } from "std-widgets.slint";

export component IconButton inherits Rectangle {
    in property <string> icon-text: "?";
    in property <string> label: "Action";
    callback clicked;
    
    width: 80px;
    height: 80px;
    background: transparent;
    
    VerticalLayout {
        spacing: 5px;
        alignment: center;
        
        Text {
            text: root.icon-text;
            font-size: 24px;
            horizontal-alignment: center;
            color: #555555;
        }
        Text {
            text: root.label;
            font-size: 12px;
            horizontal-alignment: center;
            color: #777777;
        }
    }
    
    TouchArea {
        clicked => { root.clicked(); }
    }
}
