import { LineEdit, Button } from "std-widgets.slint";

export component NavBar inherits Rectangle {
    in-out property <string> current-url;
    in property <float> loading-progress: 0.0;
    callback reload();
    callback back();
    callback forward();
    callback navigate(string);
    callback go-home();

    height: 40px;
    background: #ffffff;
    drop-shadow-blur: 5px;
    drop-shadow-color: #00000010;

    HorizontalLayout {
        padding: 5px;
        spacing: 10px;

        Button { text: "<"; width: 30px; clicked => { root.back(); } }
        Button { text: ">"; width: 30px; clicked => { root.forward(); } }
        Button { text: "R"; width: 30px; clicked => { root.reload(); } }
        Button { text: "🏠"; width: 30px; clicked => { root.go-home(); } }

        input_container := Rectangle {
            background: #f0f0f0;
            border-radius: 15px;
            border-width: 1px;
            border-color: #d0d0d0;
            height: 30px;
            
            // Ensure focus on click (BACKGROUND)
            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { input.focus(); }
            }
            
            // Progress Bar Foreground
            Rectangle {
                x: 0px;
                y: 0px;
                height: 100%;
                width: root.loading-progress * parent.width;
                background: #0078d730; // Light blue translucent fill
                border-top-left-radius: 15px;
                border-bottom-left-radius: 15px;
                border-top-right-radius: root.loading-progress >= 1.0 ? 15px : 0px;
                border-bottom-right-radius: root.loading-progress >= 1.0 ? 15px : 0px;
                visible: root.loading-progress > 0.0 && root.loading-progress < 1.0;
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                
                input := TextInput {
                    text: root.current-url;
                    font-size: 14px;
                    vertical-alignment: center;
                    color: black;
                    single-line: true;
                    
                    property <string> placeholder: "Enter URL or search...";
                    
                    accepted => { root.navigate(self.text); }
                }
            }

            // Placeholder Text (on top of input if empty)
            Text {
                text: input.placeholder;
                color: #888888;
                x: 10px;
                vertical-alignment: center;
                visible: input.text == "";
                // Pass clicks through to TouchArea behind? Or explicitly focus input?
                // Text doesn't capture mouse events by default unless checking hit test?
                // Let's add explicit TouchArea for placeholder just in case
                TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => { input.focus(); }
                }
            }
        }
    }
}
