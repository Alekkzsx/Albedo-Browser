import { LineEdit, Button } from "std-widgets.slint";

export struct ACEBox {
    x: length,
    y: length,
    width: length,
    height: length,
    background: color,
    text: string,
    font_size: length,
    text_color: color,
    image_data: image,
    has_image: bool,
    link_url: string,
    node_id: string,
    element_type: string,
    is_fixed: bool,
}

export component BrowserView inherits Rectangle {
    in-out property <string> current-url;
    callback reload();
    callback back();
    callback forward();
    callback navigate(string);
    callback pointer_click(length, length);
    callback pointer_move(length, length);

    in-out property <bool> show-start-page;
    in property <[ACEBox]> ace_model;
    in property <length> content-height: 0px; // Calculated by Rust

    Rectangle {
        background: white; // Força fundo branco para ver se algo desenha em cima
        
        Flickable {
            width: 100%;
            height: 100%;
            viewport-height: root.content-height; 

            // Container dos elementos
            Rectangle {
                width: 100%;
                height: root.content-height;

                // Mouse/Touch Handling Area (Global)
                TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: default;
                    
                    moved => {
                        root.pointer_move(self.mouse-x, self.mouse-y);
                    }
                    
                    clicked => {
                        root.pointer_click(self.mouse-x, self.mouse-y);
                    }
                }

                for box in root.ace_model : Rectangle {
                    if !box.is_fixed : Rectangle {
                        x: box.x;
                        y: box.y;
                        width: box.width;
                        height: box.height;
                        background: box.background;
                        
                        // Render image if available (element_type == "image")
                        if box.has_image && box.element_type == "image" : Image {
                            source: box.image_data;
                            width: 100%;
                            height: 100%;
                            image-fit: cover;
                        }
                        
                        // Render text only if there's actual text and NOT an image box
                        if box.text != "" && !box.has_image : Text {
                            text: box.text;
                            color: box.text_color;
                            font-size: box.font_size;
                            width: 100%;
                            height: 100%;
                            wrap: word-wrap;
                            vertical-alignment: top;
                        }
                    }
                }
            }
        }

        // FASE 19 (REAL CSS): Fixed elements rendered outside Flickable
        for box in root.ace_model : Rectangle {
            if box.is_fixed : Rectangle {
                x: box.x;
                y: box.y;
                width: box.width;
                height: box.height;
                background: box.background;
                
                if box.has_image && box.element_type == "image" : Image {
                    source: box.image_data;
                    width: 100%;
                    height: 100%;
                    image-fit: cover;
                }
                
                if box.text != "" && !box.has_image : Text {
                    text: box.text;
                    color: box.text_color;
                    font-size: box.font_size;
                    width: 100%;
                    height: 100%;
                    wrap: word-wrap;
                    vertical-alignment: top;
                }
            }
        }

    }
}
    

