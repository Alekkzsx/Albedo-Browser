import { StartPage } from "components/start_page.slint";
import { BrowserView } from "components/browser_view.slint";
import { TabBar, TabData } from "components/tab_bar.slint";
import { NavBar } from "components/nav_bar.slint";

export component AppWindow inherits Window {
    title: "Albedo Browser";
    min-width: 800px;
    min-height: 600px;
    background: #f0f4f8; // Soft light background

    in-out property <string> current-url: "";
    in-out property <bool> show-start-page: true;

    in property <[TabData]> tabs_model; // Model from Rust
    in-out property <string> system-stats: "Loading Stats...";
    in property <image> web-content-buffer;
    in property <length> content-height: 0px; // Added for scrolling
    in-out property <length> viewport-y: 0px; // Added for external scroll control
    
    in property <float> loading-progress: 0.0;
    callback navigate(string);
    callback reload();
    callback back();
    callback forward();
    
    // Internal callbacks for WRY synchronization
    callback url-updated(string, string); // (tab_id, new_url)
    callback title-updated(string, string); // (tab_id, new_title)
    
    callback request_new_tab();
    callback request_close_tab(int);
    callback request_switch_tab(int);
    callback pointer_click(length, length);
    callback pointer_move(length, length);
    callback pointer_down(length, length);
    callback pointer_up(length, length);
    callback key_down(string, string, bool, bool, bool, bool); // key, code, ctrl, shift, alt, meta
    callback key_up(string, string, bool, bool, bool, bool);
    callback scroll(length, length, float); // x, y, delta

    VerticalLayout {
        padding: 0px;
        
        // Tab Bar always visible
        TabBar {
            tabs: root.tabs_model;
            new_tab => { root.request_new_tab(); }
            close_tab(index) => { root.request_close_tab(index); }
            switch_tab(index) => { root.request_switch_tab(index); }
        }

        NavBar {
            current-url: root.current-url;
            loading-progress: root.loading-progress;
            navigate(url) => { root.navigate(url); }
            reload => { root.reload(); }
            back => { root.back(); }
            forward => { root.forward(); }
            go-home => { 
                root.show-start-page = true; 
                root.current-url = "";
            }
        }

        if root.show-start-page : StartPage {
            current-url: root.current-url;
            show-start-page: root.show-start-page;
            system-stats: root.system-stats;
            navigate(url) => { root.navigate(url); }
        }

        if !root.show-start-page : BrowserView {
            current-url: root.current-url;
            show-start-page: root.show-start-page;
            web_content_buffer: root.web-content-buffer;
            content-height: root.content-height;
            viewport-y <=> root.viewport-y;
            reload => { root.reload(); }
            back => { root.back(); }
            forward => { root.forward(); }
            navigate(url) => { root.navigate(url); }
            pointer_click(x, y) => { root.pointer_click(x, y); }
            pointer_move(x, y) => { root.pointer_move(x, y); }
            pointer_down(x, y) => { root.pointer_down(x, y); }
            pointer_up(x, y) => { root.pointer_up(x, y); }
            key_down(key, code, ctrl, shift, alt, meta) => { root.key_down(key, code, ctrl, shift, alt, meta); }
            key_up(key, code, ctrl, shift, alt, meta) => { root.key_up(key, code, ctrl, shift, alt, meta); }
            scroll(x, y, delta) => { root.scroll(x, y, delta); }
        }
    }
}
