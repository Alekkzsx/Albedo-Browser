import { LineEdit, Button, TextEdit } from "std-widgets.slint";

export struct ACEBox {
    x: length,
    y: length,
    width: length,
    height: length,
    background: color,
    text: string,
    font_size: length,
    text_color: color,
    image_data: image,
    has_image: bool,
    link_url: string,
    node_id: string,
    element_type: string,
    is_fixed: bool,
    border_width: length,
    border_color: color,
    opacity: float,
    border_radius_tl: length,
    border_radius_tr: length,
    border_radius_br: length,
    border_radius_bl: length,
    rotate: float,
    scale_x: float,
    scale_y: float,
    // Form Widgets
    is_input: bool,
    is_textarea: bool,
    is_select: bool,
    placeholder: string,
    input_value: string,
    input_type: string, // "text", "password", "date" etc.
    options: string, // Pipe items for select: "Option A|Option B"
}

export component BrowserView inherits Rectangle {
    in-out property <string> current-url;
    callback reload();
    callback back();
    callback forward();
    callback navigate(string);
    callback pointer_click(length, length);
    callback pointer_move(length, length);
    callback pointer_down(length, length);
    callback pointer_up(length, length);
    callback key_down(string, string, bool, bool, bool, bool);
    callback key_up(string, string, bool, bool, bool, bool);
    callback scroll(length, length, float);
    callback input_change(string, string);

    in-out property <bool> show-start-page;
    in property <[ACEBox]> ace_model;
    in property <length> content-height: 0px;
    in-out property <length> viewport-y <=> f.viewport-y;

    background: white;

    FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        
        key-pressed(event) => {
            key_down(event.text, event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
            accept
        }
        key-released(event) => {
            key_up(event.text, event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta);
            accept
        }

        f := Flickable {
            width: 100%;
            height: 100%;
            viewport-height: root.content-height; 

            Rectangle {
                width: 100%;
                height: root.content-height;

                TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: default;
                    
                    scroll-event(event) => {
                        scroll(self.mouse-x, self.mouse-y, event.delta-y / 1px);
                        accept
                    }
                    moved => {
                        pointer_move(self.mouse-x, self.mouse-y);
                    }
                    clicked => {
                        pointer_click(self.mouse-x, self.mouse-y);
                    }
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            pointer_down(self.mouse-x, self.mouse-y);
                        }
                        if (event.kind == PointerEventKind.up) {
                            pointer_up(self.mouse-x, self.mouse-y);
                        }
                    }
                }

                for box in root.ace_model : Rectangle {
                    if !box.is_fixed : Rectangle {
                        x: box.x;
                        y: box.y;
                        width: box.width;
                        height: box.height;
                        background: box.is_input || box.is_textarea || box.is_select ? transparent : box.background;
                        border-width: box.border_width;
                        border-color: box.border_color;
                        opacity: box.opacity;
                        border-radius: box.border_radius_tl;

                        if box.has_image && box.element_type == "image" : Image {
                            source: box.image_data;
                            width: 100%;
                            height: 100%;
                            image-fit: cover;
                            opacity: box.opacity;
                            rotation-angle: box.rotate * 1deg;
                        }
                        
                        if box.text != "" && !box.has_image && !box.is_input && !box.is_textarea && !box.is_select : Text {
                            text: box.text;
                            color: box.text_color;
                            font-size: box.font_size;
                            width: 100%;
                            height: 100%;
                            wrap: word-wrap;
                            vertical-alignment: top;
                            opacity: box.opacity;
                            rotation-angle: box.rotate * 1deg;
                        }

                        // Form Widgets (CSS Overlay Architecture)
                        if box.is_input : Rectangle {
                            width: 100%;
                            height: 100%;
                            background: box.background;
                            border-width: box.border_width;
                            border-color: box.border_color;
                            border-radius: box.border_radius_tl;
                            
                            // LineEdit base (Invisível pra herdar CSS nativo acima)
                            LineEdit {
                                width: 100%;
                                height: 100%;
                                placeholder-text: box.placeholder;
                                text: box.input_value;
                                font-size: box.font_size;
                                input-type: box.input_type == "password" ? InputType.password : InputType.text;
                                edited => {
                                    input_change(box.node_id, self.text);
                                }
                                // Em Rust/Slint 1.x o LineEdit não tem property color/background exposta 
                                // O truque é deixar a caixa parente lidar com os graficos.
                            }
                        }

                        if box.is_textarea : Rectangle {
                             width: 100%;
                             height: 100%;
                             background: box.background;
                             border-width: box.border_width;
                             border-color: box.border_color;
                             border-radius: box.border_radius_tl;
                            
                             TextEdit {
                                 width: 100%;
                                 height: 100%;
                                 text: box.input_value;
                                 font-size: box.font_size;
                                 edited => {
                                     input_change(box.node_id, self.text);
                                 }
                             }
                        }

                        if box.is_select : Rectangle {
                             width: 100%;
                             height: 100%;
                             background: white;
                             border-width: 1px;
                             border-color: #ccc;
                             Text {
                                 text: box.input_value != "" ? box.input_value : (box.placeholder != "" ? box.placeholder : "Select...");
                                 vertical-alignment: center;
                                 x: 5px;
                             }
                             // Simple arrow
                             Text {
                                 text: "▼";
                                 x: parent.width - 20px;
                                 vertical-alignment: center;
                             }
                        }
                    }
                }
            }
        }
    }

    // Fixed elements
    for box in root.ace_model : Rectangle {
        if box.is_fixed : Rectangle {
            x: box.x;
            y: box.y;
            width: box.width;
            height: box.height;
            background: box.background;
            opacity: box.opacity;
            border_radius: box.border_radius_tl;
            
            if box.has_image && box.element_type == "image" : Image {
                source: box.image_data;
                width: 100%;
                height: 100%;
                image-fit: cover;
                rotation-angle: box.rotate * 1deg;
            }
            
            if box.text != "" && !box.has_image : Text {
                text: box.text;
                color: box.text_color;
                font-size: box.font_size;
                width: 100%;
                height: 100%;
                wrap: word-wrap;
                vertical-alignment: top;
                rotation-angle: box.rotate * 1deg;
            }
        }
    }

    // --- Custom Native ScrollBars ---
    if root.content-height > root.height : Rectangle {
        width: 12px;
        height: root.height;
        x: root.width - self.width;
        y: 0px;
        background: #f0f0f0;

        // Scroll Handle (A barra que move)
        Rectangle {
            width: 8px;
            x: 2px;
            background: scroll_touch.pressed ? #707070 : (scroll_touch.has-hover ? #a0a0a0 : #c0c0c0);
            border-radius: 4px;

            // Altura do handle proporcional ao quanto estamos vendo (viewport_height vs root.height)
            height: max(30px, root.height * (root.height / root.content-height));

            // Position y = scroll percentual * espaco livre na barra (barra_toda - handle)
            y: (root.height - self.height) * (-root.viewport-y / (root.content-height - root.height));

            scroll_touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                
                property <length> start_drag_y;
                property <length> start_viewport_y;

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        self.start_drag_y = self.mouse-y;
                        self.start_viewport_y = root.viewport-y;
                    }
                }

                moved => {
                    if (self.pressed) {
                        let delta = (self.mouse-y - self.start_drag_y) / 1px;
                        // Regra de três: movendo na tela X pixels, movemos qnts pixels de documento?
                        let ratio = (root.content-height - root.height) / (root.height - parent.height);
                        let doc_delta = (delta * ratio) * 1px;
                        
                        let unchecked_y = self.start_viewport_y - doc_delta;
                        
                        // Computa os clamps (limitadores de scroll) com max/min devido à imutabilidade do let
                        let min_y = -(root.content-height - root.height);
                        let clamped_y = max(min_y, min(0px, unchecked_y));
                        
                        // Atualiza Slint via binding bidirecional com var de Root
                        root.viewport-y = clamped_y;
                    }
                }
            }
        }
    }
}
