#!/bin/sh
# Albedo Browser Enterprise Native Pre-Push Hook Backup
# Executado antes do git push para validar lints pesados e testes

echo "🚀 Running pre-push heavy quality checks..."

if command -v cargo >/dev/null 2>&1; then
    # 1. Verificação de Linter (Clippy)
    echo "🧹 Running linter checks (clippy)..."
    cargo clippy --all-targets --all-features -- -D warnings
    if [ $? -ne 0 ]; then
        echo "❌ ERRO: O Clippy encontrou avisos ou erros!"
        echo "👉 Corrija os avisos do linter antes de realizar o push."
        exit 1
    fi

    # 2. Verificação básica de compilação
    echo "🏗️ Checking build (cargo check)..."
    cargo check --all-targets --all-features
    if [ $? -ne 0 ]; then
        echo "❌ ERRO: O projeto possui erros de compilação!"
        exit 1
    fi
fi

echo "✅ All pre-push checks passed successfully!"
exit 0
