{
  "suite": "required",
  "version": 1,
  "cases": [
    {
      "case_id": "tok_basic_markup",
      "spec_ref": "WHATWG 13.2.5 Data state",
      "mode": "tokenizer",
      "input": "<div class=\"hero\">Hello</div>",
      "expected_tokens": [
        { "type": "StartTag", "name": "div", "attrs": { "class": "hero" } },
        { "type": "Character", "data": "Hello" },
        { "type": "EndTag", "name": "div" }
      ],
      "expected_errors": []
    },
    {
      "case_id": "tok_doctype_and_comment",
      "spec_ref": "WHATWG 13.2.5 Markup declaration open state",
      "mode": "tokenizer",
      "input": "<!DOCTYPE html><!-- note -->",
      "expected_tokens": [
        {
          "type": "Doctype",
          "name": "html",
          "public_id": null,
          "system_id": null,
          "force_quirks": false
        },
        { "type": "Comment", "data": " note " }
      ],
      "expected_errors": []
    },
    {
      "case_id": "tok_named_entity",
      "spec_ref": "WHATWG 13.2.5.73 Named character reference state",
      "mode": "tokenizer",
      "input": "A &amp; B",
      "expected_tokens": [
        { "type": "Character", "data": "A & B" }
      ],
      "expected_errors": []
    },
    {
      "case_id": "tok_attr_semicolon_required_historical",
      "spec_ref": "WHATWG 13.2.5.73 Historical named character reference in attributes",
      "mode": "tokenizer",
      "input": "<div title=\"x&ampy\"></div>",
      "expected_tokens": [
        { "type": "StartTag", "name": "div", "attrs": { "title": "x&ampy" } },
        { "type": "EndTag", "name": "div" }
      ],
      "expected_errors": []
    },
    {
      "case_id": "tok_rcdata_textarea",
      "spec_ref": "WHATWG 13.2.5 RCDATA states",
      "mode": "tokenizer",
      "input": "<textarea>A &lt; B</textarea>",
      "expected_tokens": [
        { "type": "StartTag", "name": "textarea", "attrs": {} },
        { "type": "Character", "data": "A < B" },
        { "type": "EndTag", "name": "textarea" }
      ],
      "expected_errors": []
    },
    {
      "case_id": "tok_rawtext_style",
      "spec_ref": "WHATWG 13.2.5 RAWTEXT states",
      "mode": "tokenizer",
      "input": "<style>A &amp; B</style>",
      "expected_tokens": [
        { "type": "StartTag", "name": "style", "attrs": {} },
        { "type": "Character", "data": "A &amp; B" },
        { "type": "EndTag", "name": "style" }
      ],
      "expected_errors": []
    },
    {
      "case_id": "doc_adoption_agency",
      "spec_ref": "WHATWG 13.2.6.4.7 Adoption agency algorithm",
      "mode": "document",
      "input": "<p><b><i>x</b>y</i></p>",
      "expected_tree": "| <html>\n|   <head>\n|   <body>\n|     <p>\n|       <b>\n|         <i>\n|           \"x\"\n|       <i>\n|         \"y\"\n",
      "expected_errors": []
    },
    {
      "case_id": "doc_foster_parenting",
      "spec_ref": "WHATWG 13.2.6.4.1 Appropriate place for inserting a node",
      "mode": "document",
      "input": "<table>hello<tr><td>cell</td></tr></table>",
      "expected_tree": "| <html>\n|   <head>\n|   <body>\n|     \"hello\"\n|     <table>\n|       <tbody>\n|         <tr>\n|           <td>\n|             \"cell\"\n",
      "expected_errors": ["TreeBuilder:FosterParenting"]
    },
    {
      "case_id": "doc_svg_namespace",
      "spec_ref": "WHATWG 13.2.6.5 Parsing tokens in foreign content",
      "mode": "document",
      "input": "<div><svg><circle/></svg></div>",
      "expected_tree": "| <html>\n|   <head>\n|   <body>\n|     <div>\n|       <svg svg>\n|         <svg circle>\n",
      "expected_errors": []
    },
    {
      "case_id": "frag_div_context",
      "spec_ref": "WHATWG 13.2.11 Parsing HTML fragments",
      "mode": "fragment",
      "context": "div",
      "input": "<span>hello</span>",
      "expected_tree": "| <span>\n|   \"hello\"\n",
      "expected_errors": []
    },
    {
      "case_id": "frag_title_context_rcdata",
      "spec_ref": "WHATWG 13.2.11 Parsing HTML fragments (title/textarea rcdata)",
      "mode": "fragment",
      "context": "title",
      "input": "A &lt; B",
      "expected_tree": "| \"A < B\"\n",
      "expected_errors": []
    },
    {
      "case_id": "tok_ambiguous_ampersand",
      "spec_ref": "WHATWG 13.2.5.74 Ambiguous ampersand state",
      "mode": "tokenizer",
      "input": "x &notanentity; y",
      "expected_tokens": [
        { "type": "Character", "data": "x ¬anentity; y" }
      ],
      "expected_errors": ["LEX001:LexerParseError"]
    },
    {
      "case_id": "frag_table_context",
      "spec_ref": "WHATWG 13.2.11 Fragment parsing in table context",
      "mode": "fragment",
      "context": "table",
      "input": "<tr><td>x</td></tr>",
      "expected_tree": "| <tbody>\n|   <tr>\n|     <td>\n|       \"x\"\n",
      "expected_errors": []
    },
    {
      "case_id": "doc_frameset_mode",
      "spec_ref": "WHATWG 13.2.6.4.20 In frameset insertion mode",
      "mode": "document",
      "input": "<html><frameset><frame src=\"a\"></frameset></html>",
      "expected_tree": "| <html>\n|   <head>\n|   <frameset>\n|     <frame>\n|       src=\"a\"\n",
      "expected_errors": []
    },
    {
      "case_id": "tok_numeric_character_hex",
      "spec_ref": "WHATWG 13.2.5.80 Hexadecimal character reference state",
      "mode": "tokenizer",
      "input": "&#x41;",
      "expected_tokens": [
        { "type": "Character", "data": "A" }
      ],
      "expected_errors": []
    },
    {
      "case_id": "tok_numeric_character_dec",
      "spec_ref": "WHATWG 13.2.5.79 Decimal character reference state",
      "mode": "tokenizer",
      "input": "&#65;",
      "expected_tokens": [
        { "type": "Character", "data": "A" }
      ],
      "expected_errors": []
    },
    {
      "case_id": "frag_select_context",
      "spec_ref": "WHATWG 13.2.11 Fragment parsing in select context",
      "mode": "fragment",
      "context": "select",
      "input": "<option>yes</option>",
      "expected_tree": "| <option>\n|   \"yes\"\n",
      "expected_errors": ["TreeBuilder:UnexpectedEof"]
    },
    {
      "case_id": "tok_attribute_unquoted",
      "spec_ref": "WHATWG 13.2.5.38 Unquoted attribute value state",
      "mode": "tokenizer",
      "input": "<div a=b></div>",
      "expected_tokens": [
        { "type": "StartTag", "name": "div", "attrs": { "a": "b" }, "self_closing": false },
        { "type": "EndTag", "name": "div" }
      ],
      "expected_errors": []
    },
    {
      "case_id": "tok_bogus_comment",
      "spec_ref": "WHATWG 13.2.5.41 Bogus comment state",
      "mode": "tokenizer",
      "input": "<?xml>",
      "expected_tokens": [
        { "type": "Comment", "data": "?xml" }
      ],
      "expected_errors": ["LEX001:LexerParseError"]
    },
    {
      "case_id": "tok_script_data_basic",
      "spec_ref": "WHATWG 13.2.5 Script Data states",
      "mode": "tokenizer",
      "input": "<script>var x = 1;</script>",
      "expected_tokens": [
        { "type": "StartTag", "name": "script", "attrs": {} },
        { "type": "Character", "data": "var x = 1;" },
        { "type": "EndTag", "name": "script" }
      ],
      "expected_errors": []
    },
    {
      "case_id": "tok_script_data_escape",
      "spec_ref": "WHATWG 13.2.5 Script Data Escape states",
      "mode": "tokenizer",
      "input": "<script><!--comment--></script>",
      "expected_tokens": [
        { "type": "StartTag", "name": "script", "attrs": {} },
        { "type": "Character", "data": "<!--comment-->" },
        { "type": "EndTag", "name": "script" }
      ],
      "expected_errors": []
    },
    {
      "case_id": "tok_cdata_section",
      "spec_ref": "WHATWG 13.2.5 CDATA section states",
      "mode": "tokenizer",
      "input": "<![CDATA[test]]>",
      "expected_tokens": [
        { "type": "Character", "data": "test" }
      ],
      "expected_errors": ["LEX001:CdataSectionOutsideForeignContent"]
    },
    {
      "case_id": "tok_null_character",
      "spec_ref": "WHATWG 13.2.5 Tokenization - null character",
      "mode": "tokenizer",
      "input": "a\u0000b",
      "expected_tokens": [
        { "type": "Character", "data": "a\u{FFFD}b" }
      ],
      "expected_errors": ["TOK004:NullCharacter"]
    },
    {
      "case_id": "tok_self_closing_tag",
      "spec_ref": "WHATWG 13.2.5 Self-closing start tag state",
      "mode": "tokenizer",
      "input": "<br/>",
      "expected_tokens": [
        { "type": "StartTag", "name": "br", "attrs": {}, "self_closing": true }
      ],
      "expected_errors": []
    },
    {
      "case_id": "tok_multiple_attributes",
      "spec_ref": "WHATWG 13.2.5 Attribute name/value states",
      "mode": "tokenizer",
      "input": "<input type=\"text\" name=email disabled>",
      "expected_tokens": [
        { "type": "StartTag", "name": "input", "attrs": { "type": "text", "name": "email", "disabled": "" }, "self_closing": false }
      ],
      "expected_errors": []
    },
    {
      "case_id": "tok_doctype_public_system",
      "spec_ref": "WHATWG 13.2.5 DOCTYPE states with public/system identifiers",
      "mode": "tokenizer",
      "input": "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">",
      "expected_tokens": [
        {
          "type": "Doctype",
          "name": "html",
          "public_id": "-//W3C//DTD XHTML 1.0 Transitional//EN",
          "system_id": "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd",
          "force_quirks": false
        }
      ],
      "expected_errors": []
    },
    {
      "case_id": "tok_comment_edge_cases",
      "spec_ref": "WHATWG 13.2.5 Comment edge cases",
      "mode": "tokenizer",
      "input": "<!---comment-->",
      "expected_tokens": [
        { "type": "Comment", "data": "-comment" }
      ],
      "expected_errors": []
    },
    {
      "case_id": "tok_nested_comment",
      "spec_ref": "WHATWG 13.2.5 Nested comment handling",
      "mode": "tokenizer",
      "input": "<!-- outer <!-- inner -->",
      "expected_tokens": [
        { "type": "Comment", "data": " outer <!-- inner " }
      ],
      "expected_errors": ["LEX001:NestedComment"]
    },
    {
      "case_id": "doc_form_elements",
      "spec_ref": "WHATWG 13.2.6 Form element parsing",
      "mode": "document",
      "input": "<form><input name=\"test\"><button>Submit</button></form>",
      "expected_tree": "| <html>\n|   <head>\n|   <body>\n|     <form>\n|       <input>\n|         name=\"test\"\n|       <button>\n|         \"Submit\"\n",
      "expected_errors": []
    },
    {
      "case_id": "doc_table_colspan",
      "spec_ref": "WHATWG 13.2.6 Table cell colspan parsing",
      "mode": "document",
      "input": "<table><tr><td colspan=\"2\">cell</td></tr></table>",
      "expected_tree": "| <html>\n|   <head>\n|   <body>\n|     <table>\n|       <tbody>\n|         <tr>\n|           <td>\n|             colspan=\"2\"\n|             \"cell\"\n",
      "expected_errors": []
    },
    {
      "case_id": "doc_list_elements",
      "spec_ref": "WHATWG 13.2.6 List element parsing",
      "mode": "document",
      "input": "<ul><li>item 1<li>item 2</ul>",
      "expected_tree": "| <html>\n|   <head>\n|   <body>\n|     <ul>\n|       <li>\n|         \"item 1\"\n|       <li>\n|         \"item 2\"\n",
      "expected_errors": []
    },
    {
      "case_id": "tok_entity_in_attribute",
      "spec_ref": "WHATWG 13.2.5 Entity in attribute value",
      "mode": "tokenizer",
      "input": "<a href=\"test?a=1&amp;b=2\">link</a>",
      "expected_tokens": [
        { "type": "StartTag", "name": "a", "attrs": { "href": "test?a=1&b=2" } },
        { "type": "Character", "data": "link" },
        { "type": "EndTag", "name": "a" }
      ],
      "expected_errors": []
    },
    {
      "case_id": "tok_rawtext_noscript",
      "spec_ref": "WHATWG 13.2.5 RAWTEXT noscript",
      "mode": "tokenizer",
      "input": "<noscript><style>.x{}</style></noscript>",
      "expected_tokens": [
        { "type": "StartTag", "name": "noscript", "attrs": {} },
        { "type": "Character", "data": "<style>.x{}</style>" },
        { "type": "EndTag", "name": "noscript" }
      ],
      "expected_errors": []
    },
    {
      "case_id": "doc_template_element",
      "spec_ref": "WHATWG 13.2.6 Template element parsing",
      "mode": "document",
      "input": "<template><div>content</div></template>",
      "expected_tree": "| <html>\n|   <head>\n|     <template>\n|       <template-content>\n|         <div>\n|           \"content\"\n|   <body>\n",
      "expected_errors": []
    },
    {
      "case_id": "tok_eof_in_tag",
      "spec_ref": "WHATWG 13.2.5 EOF in tag",
      "mode": "tokenizer",
      "input": "<div",
      "expected_tokens": [
        { "type": "Eof" }
      ],
      "expected_errors": ["LEX001:EofInTag"]
    },
    {
      "case_id": "tok_eof_in_comment",
      "spec_ref": "WHATWG 13.2.5 EOF in comment",
      "mode": "tokenizer",
      "input": "<!-- comment",
      "expected_tokens": [
        { "type": "Comment", "data": " comment" },
        { "type": "Eof" }
      ],
      "expected_errors": ["LEX001:EofInComment"]
    },
    {
      "case_id": "tok_eof_in_doctype",
      "spec_ref": "WHATWG 13.2.5 EOF in DOCTYPE",
      "mode": "tokenizer",
      "input": "<!DOCTYPE html",
      "expected_tokens": [
        {
          "type": "Doctype",
          "name": "html",
          "public_id": null,
          "system_id": null,
          "force_quirks": true
        },
        { "type": "Eof" }
      ],
      "expected_errors": ["LEX001:EofInDoctype"]
    },
    {
      "case_id": "doc_html_namespace",
      "spec_ref": "WHATWG 13.2.6 HTML namespace handling",
      "mode": "document",
      "input": "<html><head></head><body></body></html>",
      "expected_tree": "| <html>\n|   <head>\n|   <body>\n",
      "expected_errors": []
    },
    {
      "case_id": "frag_script_context",
      "spec_ref": "WHATWG 13.2.11 Fragment parsing in script context",
      "mode": "fragment",
      "context": "script",
      "input": "var x = '<div>';",
      "expected_tree": "| \"var x = '<div>';\"\n",
      "expected_errors": []
    },
    {
      "case_id": "tok_double_escaped_script",
      "spec_ref": "WHATWG 13.2.5 Script Data Double Escape states",
      "mode": "tokenizer",
      "input": "<script><!--<script>alert(1)</script>--></script>",
      "expected_tokens": [
        { "type": "StartTag", "name": "script", "attrs": {} },
        { "type": "Character", "data": "<!--<script>alert(1)</script>-->" },
        { "type": "EndTag", "name": "script" }
      ],
      "expected_errors": []
    }
  ]
}
